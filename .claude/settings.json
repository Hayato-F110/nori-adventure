{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-secrets.mjs"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format-and-lint.mjs"],
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push*--force*)",
      "Bash(git push* -f*)",
      "Bash(gh repo edit*--visibility*)",
      "Bash(gh repo delete*)",
      "Bash(reg add*)",
      "Bash(reg delete*)",
      "Bash(setx*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push*--force*)",
      "PowerShell(git push* -f*)",
      "PowerShell(gh repo edit*--visibility*)",
      "PowerShell(gh repo delete*)",
      "PowerShell(Set-ExecutionPolicy*)",
      "PowerShell(Set-ItemProperty*HKLM*)",
      "PowerShell(New-ItemProperty*HKLM*)",
      "PowerShell(reg add*)",
      "PowerShell(reg delete*)",
      "PowerShell(setx*)",
      "mcp__claude_ai_Atlassian_MCP__executeWrite",
      "mcp__claude_ai_Atlassian_MCP__executeDestructive",
      "Bash(git push*origin main)",
      "Bash(git push*origin main *)",
      "Bash(git push*:main*)",
      "Bash(git push*origin HEAD)",
      "PowerShell(git push*origin main)",
      "PowerShell(git push*origin main *)",
      "PowerShell(git push*:main*)",
      "PowerShell(git push*origin HEAD)"
    ],
    "ask": [
      "Bash(rm -rf*)",
      "Bash(rm -r *)",
      "Bash(rm -fr*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git push origin --delete*)",
      "Bash(git push origin :*)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(gh release delete*)",
      "Bash(winget install*)",
      "PowerShell(Remove-Item*)",
      "PowerShell(rm *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git push origin --delete*)",
      "PowerShell(git rebase*)",
      "PowerShell(winget install*)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx vitest*)",
      "Bash(npx playwright test*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(npm run *)",
      "PowerShell(npm test*)"
    ]
  }
}
